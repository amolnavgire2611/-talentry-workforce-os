# Copy to .env. Local default keeps the existing backend/users.db.
APP_ENV=development
# Optional override; unset uses the existing backend/users.db by default.
# DATABASE_URL=sqlite:////absolute/path/to/login-app/backend/users.db
NEXORA_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# Set a private random value of at least 32 characters to enable first-admin registration in the UI.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_BOOTSTRAP_TOKEN=
ACCESS_TOKEN_MINUTES=15
REFRESH_SESSION_DAYS=7
# COOKIE_SECURE defaults to true in production and false in development.
# COOKIE_SECURE=false
TOKEN_ISSUER=nexora-workforce
TOKEN_AUDIENCE=nexora-workforce-api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EMPLOYEE_DIRECTORY_ENABLED=false
